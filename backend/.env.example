# Copy this file to .env and fill in real values. Never commit the real .env file (see .gitignore).
#
# One of these .env files exists PER CLIENT DEPLOYMENT. All deployments point at the same shared
# Postgres (same POSTGRES_* below, same host) - what makes each deployment belong to one client is
# ORG_ID/ORG_NAME: every row this container ever writes gets stamped with its own ORG_ID, and
# /activate + gen_key.py only ever operate on that one org. To onboard a new client: copy this file,
# pick a unique ORG_ID, deploy a new api/worker/scheduler on their own domain pointed at this same
# Postgres - no schema change needed per client.

POSTGRES_DB=oneorder
POSTGRES_USER=oneorder
POSTGRES_PASSWORD=change-me

# The port the api container's /health (and /activate) endpoint is reachable on from the host.
API_PORT=8000

# Unique per client deployment - e.g. "hotel-taj-pune". Lowercase, no spaces; this becomes the
# primary key every device/activation-key row is scoped to. Never reuse one across two clients.
ORG_ID=change-me
# Human-readable name, shown back to the app after a successful activation. Free text.
ORG_NAME=change-me

# Leave blank on every client-facing deployment (the default - /admin/* 403s with no token set).
# Set this ONLY on a deployment no client app ever points at, for your own cross-client visibility
# (GET /admin/orgs, GET /admin/orgs/{org_id}/devices) - see backend/README.md.
ADMIN_TOKEN=

# This deployment's own public URL, e.g. "https://cafe-aroma.oneorder.co.in" (no trailing slash) -
# used only to build full, scannable table QR links (see main.py's _table_url). Leave blank in
# local dev; /tables/sync still returns a working relative "/t/{token}" path without it.
PUBLIC_BASE_URL=

# Lets the worker container mirror a confirmed order into this org's Firestore project - the SAME
# Firebase project oneorder/src/sync/firebaseBackend.ts already syncs to, so the admin/waiter app's
# existing listeners pick up a QR order with no app-side changes. Generate this in the Firebase
# console under Project settings -> Service accounts -> Generate new private key, then paste the
# entire downloaded JSON file as one line here. Leave blank to accept orders without live Chef/
# Admin sync - they still land safely in Postgres (see Order.status = 'mirror_failed').
FIREBASE_SERVICE_ACCOUNT_JSON=
# Must match oneorder's own EXPO_PUBLIC_FIREBASE_STORE_ID for this same client (see
# oneorder/src/sync/firebaseBackend.ts) - both sides write/read "stores/{this}/...". Defaults to
# "default", matching the app's own default when that variable is unset.
FIREBASE_STORE_ID=default

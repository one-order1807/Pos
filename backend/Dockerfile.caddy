# Build context is the repo root (see docker-compose.yml's `caddy` service) so this stage can
# reach ../customer-web from here - keeps this a single image to build rather than a separate
# Node service just to hold a static build.
FROM node:22-alpine AS build-web
WORKDIR /web
COPY customer-web/package.json customer-web/package-lock.json ./
RUN npm ci
COPY customer-web/ ./
RUN npm run build

FROM caddy:2-alpine
COPY backend/Caddyfile /etc/caddy/Caddyfile
COPY --from=build-web /web/dist /site

# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave empty to run fully offline (local SQLite only).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# One id per cafe/branch. Data is stored under stores/<id>/...
EXPO_PUBLIC_FIREBASE_STORE_ID=default

# This client's backend deployment (see backend/.env.example's ORG_ID in the Phase-2-backend
# branch - that deployment and this URL are a matched pair). Used only for first-launch device
# activation (src/activation/activate.ts) right now. Leave empty to build with activation
# effectively disabled (the gate will show a "contact support" error instead of a network call).
EXPO_PUBLIC_BACKEND_URL=

# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave empty to run fully offline (local SQLite only).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# One id per cafe/branch. Data is stored under stores/<id>/...
EXPO_PUBLIC_FIREBASE_STORE_ID=default
